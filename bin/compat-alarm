#!/usr/bin/env bash
# Run a previous release's tests against the working tree. Red means the
# published contract changed under its name; green is an alarm, not proof.
# Usage: bin/compat-alarm <previous-release-tag>
set -euo pipefail

if [[ "$#" -ne 1 ]]; then
  echo "usage: compat-alarm <previous-release-tag>" >&2
  exit 2
fi
tag="$1"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
git archive "$tag" | tar -x -C "$tmp"

src_paths=""
while IFS= read -r src; do
  src_paths+="\"$src\" "
done < <(find . -type d -name src -not -path './.git/*' | sort)

test_paths=""
while IFS= read -r test; do
  test_paths+="\"$test\" "
done < <(find "$tmp" -type d -name test | sort)

nss=""
while IFS= read -r file; do
  rel="${file#*/test/}"
  nss+="$(echo "${rel%.clj}" | tr '/_' '.-') "
done < <(find "$tmp" -path '*/test/*' -name '*_test.clj' | sort)
[ -n "$nss" ] || { echo "no test namespaces found at $tag"; exit 2; }

requires=""
syms=""
for ns in $nss; do
  requires+="'$ns "
  syms+="'$ns "
done

# Frozen tests run the working devflow source. Mirror the :test alias's
# approved Millstrand roots so this alarm proves the archived suite against the
# candidate rather than failing before either namespace loads.
millstrand_root="../millstrand"
workflow_root="$millstrand_root/spools/workflow"
kanban_sha="87f61bc2750e7026f3650235907db25f19b1536e"

exec clojure -Sdeps "{:paths [${src_paths}${test_paths}]
                      :deps {io.millstrand/millstrand {:local/root \"$millstrand_root\"}
                             io.millstrand/workflow-spool {:local/root \"$workflow_root\"}
                             io.github.codethread/kanban.spool
                             {:git/url \"https://github.com/codethread/kanban.spool.git\"
                              :git/tag \"v24\"
                              :git/sha \"$kanban_sha\"}}}" -M -e "
(require 'clojure.test ${requires})
(let [result (apply clojure.test/run-tests [${syms}])]
  (System/exit (if (zero? (+ (:fail result) (:error result))) 0 1)))"
